{
  "agent": {
    "sdd-apply": {
      "prompt": "{file:./prompts/generated/phases/sdd-apply.md}"
    },
    "sdd-verify": {
      "prompt": "{file:./prompts/generated/phases/sdd-verify.md}"
    },
    "sdd-spec": {
      "prompt": "{file:./prompts/generated/phases/sdd-spec.md}"
    },
    "sdd-design": {
      "prompt": "{file:./prompts/generated/phases/sdd-design.md}"
    },
    "sdd-tasks": {
      "prompt": "{file:./prompts/generated/phases/sdd-tasks.md}"
    },
    "sdd-archive": {
      "prompt": "{file:./prompts/generated/phases/sdd-archive.md}"
    },
    "sdd-explore": {
      "prompt": "{file:./prompts/generated/phases/sdd-explore.md}"
    },
    "sdd-propose": {
      "prompt": "{file:./prompts/generated/phases/sdd-propose.md}"
    },
    "sdd-init": {
      "prompt": "{file:./prompts/generated/phases/sdd-init.md}"
    },
    "sdd-onboard": {
      "prompt": "{file:./prompts/generated/phases/sdd-onboard.md}"
    },
    "review-readability": {
      "prompt": "{file:./prompts/generated/phases/review-readability.md}"
    },
    "review-reliability": {
      "prompt": "{file:./prompts/generated/phases/review-reliability.md}"
    },
    "review-resilience": {
      "prompt": "{file:./prompts/generated/phases/review-resilience.md}"
    },
    "review-risk": {
      "prompt": "{file:./prompts/generated/phases/review-risk.md}"
    },
    "review-refuter": {
      "prompt": "{file:./prompts/generated/phases/review-refuter.md}"
    },
    "jd-fix-agent": {
      "prompt": "{file:./prompts/generated/phases/jd-fix-agent.md}"
    },
    "jd-judge-a": {
      "prompt": "{file:./prompts/generated/phases/jd-judge-a.md}"
    },
    "jd-judge-b": {
      "prompt": "{file:./prompts/generated/phases/jd-judge-b.md}"
    },
    "tony-orchestrator": {
      "description": "Tony AI SDD Orchestrator - coordinates sub-agents, never does work inline",
      "mode": "primary",
      "model": "ollama/qwen3-coder:30b",
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "jd-fix-agent": "allow",
          "jd-judge-a": "allow",
          "jd-judge-b": "allow",
          "review-readability": "allow",
          "review-refuter": "allow",
          "review-reliability": "allow",
          "review-resilience": "allow",
          "review-risk": "allow",
          "sdd-apply": "allow",
          "sdd-archive": "allow",
          "sdd-design": "allow",
          "sdd-explore": "allow",
          "sdd-init": "allow",
          "sdd-onboard": "allow",
          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-tasks": "allow",
          "sdd-verify": "allow"
        }
      },
      "prompt": "{file:./prompts/generated/tony-orchestrator.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "question": true,
        "read": true,
        "task": true,
        "write": true
      }
    },
    "gga-reviewer": {
      "description": "GGA code reviewer — responde directo al prompt de gga, no delega",
      "hidden": true,
      "mode": "subagent",
      "model": "ollama/qwen3-coder:30b",
      "prompt": "You are a code reviewer invoked by gga (Gentleman Guardian Angel).\n\nYou receive staged code changes and the project coding standards (AGENTS.md).\nReview the diff directly and respond with findings. Do NOT delegate or spawn sub-agents.\n\nFor each issue found, report:\n- File and line\n- What the problem is\n- Why it violates the standards\n- Suggested fix\n\nIf the code is clean, say so explicitly. Be concise and technical.",
      "tools": {
        "bash": false,
        "edit": false,
        "read": true,
        "task": false,
        "write": false
      }
    }
  },
  "default_agent": "tony-orchestrator",
  "plugin": [
    "plugins/tony-kernel/index.ts"
  ],
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "tonymem": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/local-memory/server.py"
      ],
      "type": "local",
      "environment": {
        "LOCAL_MEMORY_DB": "{env:PWD}/.tonymem/memory.db",
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}"
      }
    },
    "code-index": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/code-index/server.py"
      ],
      "type": "local",
      "environment": {
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}",
        "TONY_INDEX_ROOT": "{env:PWD}",
        "TONY_OLLAMA_URL": "http://localhost:11434",
        "TONY_QDRANT_URL": "http://localhost:6333",
        "TONY_EMBED_MODEL": "bge-m3",
        "TONY_INDEX_CHUNKER": "regex"
      }
    },
    "judgment-memory": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/judgment-memory/server.py"
      ],
      "type": "local",
      "environment": {
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}",
        "JUDGMENT_MEMORY_DB": "{env:PWD}/.tonymem/judgment-memory.db",
        "TONY_OLLAMA_URL": "http://localhost:11434",
        "TONY_QDRANT_URL": "http://localhost:6333",
        "TONY_EMBED_MODEL": "nomic-embed-text",
        "TONY_RECALL_SCORE_THRESHOLD": "0.5"
      }
    },
    "tony-kernel": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/kernel/mcp_server.py"
      ],
      "type": "local",
      "environment": {
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}",
        "TONY_KERNEL_STATE_DIR": "{env:PWD}/.tony-kernel/kernel-state.json"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "share": "disabled",
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder:30b": {
          "options": {
            "numCtx": 32768
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "omnicoder:9b": {
          "options": {
            "numCtx": 16384
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "deepseek-r1:14b": {
          "options": {
            "numCtx": 16384
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "ornith:9b": {
          "options": {
            "numCtx": 16384
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
