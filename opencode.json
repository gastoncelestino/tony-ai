{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/trace.ts"
  ],
  "provider": {
    "llamaswap": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3-coder-30b": {
          "name": "Qwen3-Coder",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "ttl": 600
        },
        "ornith-1.5-9b": {
          "name": "Ornith 1.5",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "ttl": 600
        },
        "deepseek-r1-8b": {
          "name": "DeepSeek R1",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "ttl": 600
        },
        "qwen-3.8-9b": {
          "name": "Qwen 3.8",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "ttl": 600
        }
      }
    }
  },
  "agent": {
    "gentle-orchestrator": {
      "mode": "primary",
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "sdd-explore": "allow",
          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-design": "allow",
          "sdd-tasks": "allow",
          "sdd-apply": "allow",
          "sdd-verify": "allow",
          "sdd-archive": "allow"
        },
        "tools": {
          "bash": "deny",
          "read": "deny",
          "edit": "deny",
          "glob": "deny",
          "grep": "deny",
          "list": "deny",
          "webfetch": "deny",
          "websearch": "deny"
        }
      }
    },
    "sdd-explore": {
      "hidden": true,
      "mode": "subagent",
	  "prompt": "You are Tony's exploration agent.\nComplete ONLY the assigned task directly \n— you have NO ability to delegate or spawn subagents (the task tool is unavailable to you).\n- Investigate using the minimum necessary tool calls.\n- Prefer direct evidence.\n- Do not modify files. Do not investigate unrelated areas.\n- Stop as soon as the task is sufficiently proven.\nDEFAULT BEHAVIOR (use this for every assigned task, including this one): respond with:\n- conclusion (direct answer to what was asked)\n- evidence (files/lines that prove it)\n- relevant files\nONLY return the {'tasks':[...]} JSON format if your prompt explicitly and literally asks you to 'decompose' or 'produce a TaskSet'. If unsure, default to conclusion/evidence/relevant files",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "deny"
      }
    },
    "sdd-propose": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "sdd-spec": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "sdd-design": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "sdd-tasks": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "sdd-apply": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "edit": "allow",
        "task": "deny"
      }
    },
    "sdd-verify": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "edit": "deny",
        "task": "deny"
      }
    },
    "sdd-archive": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "deny",
        "task": "deny"
      }
    },
    "sdd-init": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "sdd-onboard": {
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    }
  },
  "default_agent": "gentle-orchestrator",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "share": "disabled"
}