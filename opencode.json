  "default_agent": "tony-orchestrator",
  "plugin": [
    "plugins/tony-kernel/index.ts"
  ],
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "tonymem": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/local-memory/server.py"
      ],
      "type": "local",
      "environment": {
        "LOCAL_MEMORY_DB": "{env:PWD}/.tonymem/memory.db",
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}"
      }
    },
    "code-index": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/code-index/server.py"
      ],
      "type": "local",
      "environment": {
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}",
        "TONY_INDEX_ROOT": "{env:PWD}",
        "TONY_OLLAMA_URL": "http://localhost:11434",
        "TONY_QDRANT_URL": "http://localhost:6333",
        "TONY_EMBED_MODEL": "bge-m3",
        "TONY_INDEX_CHUNKER": "regex"
      }
    },
    "judgment-memory": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/judgment-memory/server.py"
      ],
      "type": "local",
      "environment": {
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}",
        "JUDGMENT_MEMORY_DB": "{env:PWD}/.tonymem/judgment-memory.db",
        "TONY_OLLAMA_URL": "http://localhost:11434",
        "TONY_QDRANT_URL": "http://localhost:6333",
        "TONY_EMBED_MODEL": "nomic-embed-text",
        "TONY_RECALL_SCORE_THRESHOLD": "0.5"
      }
    },
    "tony-kernel": {
      "command": [
        "python3",
        "{env:TONY_REPO_ROOT}/kernel/mcp_server.py"
      ],
      "type": "local",
      "environment": {
        "TONY_REPO_ROOT": "{env:TONY_REPO_ROOT}",
        "TONY_KERNEL_STATE_DIR": "{env:PWD}/.tony-kernel/kernel-state.json"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "share": "disabled",
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder:30b": {
          "options": {
            "numCtx": 32768
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "omnicoder:9b": {
          "options": {
            "numCtx": 16384
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "deepseek-r1:14b": {
          "options": {
            "numCtx": 16384
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "ornith:9b": {
          "options": {
            "numCtx": 16384
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
