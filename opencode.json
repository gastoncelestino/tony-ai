{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/observability.ts"],
  "provider": {
    "llamaswap": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {"baseURL": "http://127.0.0.1:8080/v1"},
      "models": {
        "qwen3-coder-30b": {"name": "Qwen3-Coder", "limit": {"context": 32768, "output": 8192}, "ttl": 600},
        "ornith-1.5-9b": {"name": "Ornith 1.5", "limit": {"context": 131072, "output": 8192}, "ttl": 600},
        "deepseek-r1-8b": {"name": "DeepSeek R1", "limit": {"context": 32768, "output": 8192}, "ttl": 600},
        "qwen-3.8-9b": {"name": "Qwen 3.8", "limit": {"context": 32768, "output": 8192}, "ttl": 600}
      }
    }
  },
  "agent": {
    "tony-stark": {
      "mode": "primary",
      "permission": {
        "question": "allow",
        "task": {"*": "deny", "sdd-explore": "allow", "sdd-propose": "allow", "sdd-spec": "allow", "sdd-design": "allow", "sdd-tasks": "allow", "sdd-apply": "allow", "sdd-verify": "allow", "sdd-archive": "allow", "sdd-init": "allow", "sdd-onboard": "allow"},
        "bash": "deny", "read": "deny", "edit": "deny", "write": "deny", "glob": "deny", "grep": "deny", "list": "deny", "webfetch": "deny", "websearch": "deny", "tony-tools_batch_read": "deny"
      }
    },
    "sdd-explore": {
      "hidden": true,
      "mode": "subagent",
      "steps": 12,
      "permission": {"read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny", "todowrite": "deny", "webfetch": "deny", "websearch": "deny", "tony-tools_batch_read": "allow"}
    },
    "sdd-propose": {"hidden": true, "mode": "subagent", "steps": 10, "permission": {"read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny"}},
    "sdd-spec": {"hidden": true, "mode": "subagent", "steps": 14, "permission": {"read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny"}},
    "sdd-design": {"hidden": true, "mode": "subagent", "steps": 14, "permission": {"read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny"}},
    "sdd-tasks": {"hidden": true, "mode": "subagent", "steps": 10, "permission": {"read": "allow", "glob": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny"}},
    "sdd-apply": {"hidden": true, "mode": "subagent", "steps": 25, "permission": {"read": "allow", "glob": "allow", "list": "allow", "bash": "allow", "edit": "allow", "task": "deny"}},
    "sdd-verify": {"hidden": true, "mode": "subagent", "steps": 12, "permission": {"read": "allow", "glob": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny"}},
    "sdd-archive": {"hidden": true, "mode": "subagent", "steps": 8, "permission": {"read": "allow", "glob": "allow", "list": "allow", "edit": "allow", "bash": "deny", "task": "deny"}},
    "sdd-init": {"hidden": true, "mode": "subagent", "steps": 12, "permission": {"read": "allow", "glob": "allow", "list": "allow", "edit": "allow", "bash": "allow", "task": "deny"}},
    "sdd-onboard": {"hidden": true, "mode": "subagent", "steps": 15, "permission": {"read": "allow", "glob": "allow", "list": "allow", "edit": "deny", "bash": "deny", "task": "deny"}}
  },
  "default_agent": "tony-stark",
  "mcp": {
    "context7": {"enabled": true, "type": "remote", "url": "https://mcp.context7.com/mcp"},
    "tonymem": {"enabled": true, "type": "local", "command": ["python3", "local-memory/server.py"], "timeout": 5000}
  },
  "share": "disabled"
}
