          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-tasks": "allow",
          "sdd-verify": "allow"
        }
      },
      "prompt": "{file:./prompts/generated/tony-orchestrator.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "question": true,
        "read": true,
        "task": true,
        "write": true
