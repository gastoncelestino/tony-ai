{
  "$schema": "https://opencode.ai/config.json",  
  "plugin": [
        "./plugins/trace.ts"
    ],
    "provider": {
        "llamaswap": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "qwen3-coder:30b": {
                    "name": "Qwen3-Coder 30B",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    },
                    "ttl": 600
                },
                "ornith-1.5-9b": {
                    "name": "Ornith 1.5 9B",
                    "limit": {
                        "context": 131072,
                        "output": 8192
                    },
                    "ttl": 600
                },
                "deepseek-r1-8b": {
                    "name": "DeepSeek R1 8B",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    },
                    "ttl": 600
                },
                "qwen-3.8-9b": {
                    "name": "Qwen 3.8 9B",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    },
                    "ttl": 600
                }
            }
        }
    },
    "model": "llamaswap/qwen3-coder:30b",
  "agent": {
    "explore": {
      "hidden": true,
      "mode": "subagent",
      "tools": {
        "bash": false,
        "codegraph_codegraph_explore": true,
        "edit": false,
        "read": true,
        "task": false,
        "write": false
      }
    },
    "general": {
      "hidden": true,
      "mode": "subagent",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "task": false,
        "write": true
      }
    },
    "gentle-orchestrator": {
      "mode": "primary",
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "jd-fix-agent": "allow",
          "jd-judge-a": "allow",
          "jd-judge-b": "allow",
          "review-readability": "allow",
          "review-refuter": "allow",
          "review-reliability": "allow",
          "review-resilience": "allow",
          "review-risk": "allow",
          "review-validator": "allow",
          "sdd-apply": "allow",
          "sdd-archive": "allow",
          "sdd-design": "allow",
          "sdd-explore": "allow",
          "sdd-init": "allow",
          "sdd-onboard": "allow",
          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-tasks": "allow",
          "sdd-verify": "allow"
        }
      },
      "tools": {
        "bash": true,
        "edit": true,
        "question": true,
        "read": true,
        "task": true,
        "write": true
