#!/bin/bash
# Pre-commit hook: validate prompt bundles are up to date
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "▶ Checking prompt bundles..."
if make check-prompts 2>/dev/null; then
  echo "✓ Prompt bundles are up to date"
else
  echo "✗ Prompt bundles are out of date. Run: make build-prompts"
  exit 1
fi
