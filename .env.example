# Tony-AI bootstrap env. Copia a .env o exporta en tu shell.

# Obligatoria por todos los MCP servers - apunta a la raiz del repo clonado.
TONY_REPO_ROOT=/path/to/tony-ai

# Runtime state (outside the checkout). SQLite memory databases intentionally
# remain in .tonymem/ because they are persistent project-local stores.
TONY_RUNTIME_DIR=$HOME/.tony-ai/tony-ai

# Endpoints de servicios.
TONY_OLLAMA_URL=http://localhost:11434
TONY_QDRANT_URL=http://localhost:6333

# Modelos de embedding.
JUDGMENT_EMBED_MODEL=nomic-embed-text
CODE_EMBED_MODEL=bge-m3

# Modelo de implementacion.
TONY_IMPLEMENTATION_MODEL=carstenuhlig/omnicoder-2-9b:q4_k_m

# Chunker obligatorio de code-index.
TONY_INDEX_CHUNKER=tree-sitter
