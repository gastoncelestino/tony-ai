{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tony-ai.local/schemas/judgment-record.json",
  "title": "judgment-memory.record",
  "description": "One persisted outcome of a Judgment Day lineage.",
  "type": "object",
  "required": ["execution_id", "task", "final", "created_at"],
  "properties": {
    "execution_id": { "type": "string" },
    "project": { "type": "string", "default": "default" },
    "task": { "type": "string" },
    "type": { "type": "string", "enum": ["judgment"], "default": "judgment" },
    "judge_a": { "$ref": "#/$defs/judgeVerdict" },
    "judge_b": { "$ref": "#/$defs/judgeVerdict" },
    "agreement": { "type": "string", "enum": ["confirmed", "suspect", "contradiction"] },
    "winner": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "final": { "type": "string", "enum": ["approve", "reject", "escalated"] },
    "fix": { "type": "string" },
    "lesson": { "type": "string" },
    "source_lineage_id": { "type": "string" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Stable references to the evidence that justified or contradicted this judgment."
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "judgeVerdict": {
      "type": "object",
      "required": ["model", "decision"],
      "properties": {
        "model": { "type": "string" },
        "decision": { "type": "string", "enum": ["approve", "reject"] }
      }
    }
  }
}
