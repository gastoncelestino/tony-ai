# docker/.env.example
#
# Copy to docker/.env if you want to override any default (all of these
# already match what code-index/, judgment-memory/, plugins/qdrant.ts, and
# opencode.json assume by default — you only need this file if you're
# running multiple instances on one host, or already have something else
# bound to 11434/6333).

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434

# Embedding models pulled by the ollama-pull one-shot service.
JUDGMENT_EMBED_MODEL=nomic-embed-text
CODE_EMBED_MODEL=bge-m3
