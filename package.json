{
  "name": "opencode-subagent-statusline",
  "version": "0.7.0",
  "description": "OpenCode plugin that exposes subagent session statusline state",
  "type": "module",
  "engines": {
    "node": "22.22.1"
  },
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./runtime": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "overrides": {
    "ini": "6.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.22",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "22.20.1",
    "esbuild-plugin-solid": "0.6.0",
    "solid-js": "1.9.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}