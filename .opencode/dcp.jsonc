{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // DCP (github.com/Opencode-DCP/opencode-dynamic-context-pruning) is a real,
  // separately-maintained OpenCode plugin — not something built for this fork.
  // Install it once, globally: `opencode plugin @tarquinen/opencode-dcp@latest --global`
  // This file only carries the PROJECT-level overrides for Tony-AI. See
  // TONY-AI-INSTALL.md section 8 for the full setup.
  "enabled": true,
  "debug": false,
  "pruneNotification": "detailed",
  "pruneNotificationType": "chat",

  // Your models are local (Ollama), not frontier cloud models — two
  // consequences that shape everything below:
  //   1. Real usable context is whatever `num_ctx` you configured per model
  //      in Ollama (often much smaller than the architecture's advertised
  //      max, and NOT auto-detected by DCP's percentage math unless your
  //      OpenCode provider entry declares the same number as `limit.context`).
  //      Check with `ollama show <model>` before trusting the numbers below.
  //   2. Smaller/weaker local models are less reliable at deciding on their
  //      own to call `compress` — so nudging is turned up (nudgeForce:
  //      "strong") rather than left on the "soft" default.
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    "summaryBuffer": true,

    // Conservative global fallback for any model not listed in
    // modelMaxLimits/modelMinLimits below. Deliberately low — better to
    // compress a bit early on an unknown/misconfigured local model than to
    // overflow it and get a hard truncation from the runtime instead.
    "maxContextLimit": 12000,
    "minContextLimit": 6000,

    // Per-model overrides, keyed by the exact "provider/model" strings used
    // in opencode.json's agent.*.model fields (Model Router). Percentages
    // are of whatever context length your OpenCode provider config declares
    // for that model — verify that number is accurate before trusting these.
    // Numbers below assume a fairly typical 32K num_ctx for the 9B/14B
    // models and the 30B running with more headroom at 64K; ADJUST to your
    // actual Ollama num_ctx per model.
    "modelMaxLimits": {
      "ollama/qwen3-coder:30b": "75%",
      "ollama/omnicoder:9b": "70%",
      "ollama/deepseek-r1:14b": "70%",
      "ollama/ornith:9b": "70%"
    },
    "modelMinLimits": {
      "ollama/qwen3-coder:30b": "40%",
      "ollama/omnicoder:9b": "35%",
      "ollama/deepseek-r1:14b": "35%",
      "ollama/ornith:9b": "35%"
    },

    "nudgeFrequency": 3,
    "iterationNudgeThreshold": 10,
    "nudgeForce": "strong",

    // TonyMem/code-index tool outputs are already small and summary-shaped
    // (mem_search/mem_context return truncated snippets, code_search returns
    // scored chunks) — not worth special-casing into the compression
    // summary the way task/skill/todowrite already are by default.
    "protectedTools": [],
    "protectUserMessages": false
  },

  // SDD artifacts (proposal/design/tasks/specs) live on disk under
  // openspec/changes/<change-name>/** when artifact_store is "openspec" or
  // "hybrid" (see skills/_shared/sdd-status-contract.md). These files get
  // read/edited repeatedly across a long SDD session — never worth pruning.
  "protectedFilePatterns": [
    "openspec/changes/**",
    "AGENTS.md",
    "opencode.json"
  ],

  "turnProtection": {
    "enabled": true,
    "turns": 4
  },

  "commands": {
    "enabled": true,
    "protectedTools": []
  },

  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  "experimental": {
    "allowSubAgents": false,
    "customPrompts": false
  },

  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": []
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": []
    }
  }
}
