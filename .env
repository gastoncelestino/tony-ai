# Runtime state
TONY_RUNTIME_DIR=${HOME}/.tony-ai
PYTHON_CACHE_DIR=${HOME}/.tony-ai/pycache
PYTHONPYCACHEPREFIX=${PYTHON_CACHE_DIR}
PYTEST_CACHE_DIR=${PYTHON_CACHE_DIR}/pytest
TONY_QDRANT_BIN=/usr/local/bin/qdrant
# Service endpoints
# Los modelos de embeddings (nomic-embed-text, bge-m3) estan declarados en
# config.yaml y se sirven via llama-swap, igual que los modelos de chat -
# por eso apunta al mismo puerto que TONY_LLAMASWAP_URL. El nombre de la
# variable quedo como TONY_EMBEDDINGS_URL porque asi la leen code-index/,
# judgment-memory/ y plugins/qdrant.ts (ya no habla el protocolo nativo de
# ahora usa /v1/embeddings compatible con OpenAI, servido por llama-swap).
TONY_EMBEDDINGS_URL=http://localhost:8080
TONY_QDRANT_URL=http://localhost:6333

# llama.cpp + llama-swap ---
TONY_LLAMASWAP_CONFIG=${REPO_ROOT}/config.yaml
TONY_LLAMASWAP_URL=http://localhost:8080
# Ruta donde vas a dejar el config.yaml de llama-swap
# Ruta al binario compilado de llama-server
TONY_LLAMA_SERVER_BIN=${HOME}/llama.cpp/build/bin/llama-server
# Opcional: si el warm-up de modelos al final de setup.sh te tarda mucho
# (normal con el 30B en la primera carga), subi este timeout en vez de
# bajarlo. Poner TONY_WARM_MODELS=0 para saltear el warm-up por completo.
TONY_WARM_MODELS=1
TONY_MODEL_WARMUP_TIMEOUT=120

# Modelos por rol
TONY_PLANNING_MODEL=qwen3-coder:30b
TONY_REVIEW_MODEL=deepseek-r1:14b

# Embedding models
JUDGMENT_EMBED_MODEL=nomic-embed-text
CODE_EMBED_MODEL=bge-m3

# Implementation model
TONY_IMPLEMENTATION_MODEL=ornith-1.5-9b

# Code index chunker
TONY_INDEX_CHUNKER=tree-sitter
